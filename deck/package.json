{
  "name": "video-gaming-agents-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts VideoGamingAgents out/video-gaming-agents-classic-4x3.mp4 --codec=h264 --crf=18",
    "render:previews": "node scripts/render-previews.mjs",
    "still": "remotion still src/index.ts VideoGamingAgents"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/player": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "7.1.9"
  }
}
